# ============ Обязательное ============
# Токен от @BotFather
BOT_TOKEN=

# ============ Доступ ============
# Список Telegram user ID через запятую. Пусто = бот публичный.
# Для публичного бота работают квоты и сетевая политика ниже.
# Свой ID можно узнать у @userinfobot.
ALLOWED_USER_IDS=

# Полностью выключить экспорт ключей на удалённые серверы (0/1)
SSH_EXPORT_ENABLED=1

# ============ Сетевая политика ============
# Разрешить подключения в приватные сети
# ДЛЯ ПУБЛИЧНОГО БОТА ДОЛЖНО БЫТЬ 0.
# 1 имеет смысл только для закрытого бота (с ALLOWED_USER_IDS) внутри
# собственного периметра.
ALLOW_PRIVATE_TARGETS=0

# ============ Квоты на SSH ============
# probe — обращения за ключом хоста (по сути проверка «есть ли тут SSH»)
QUOTA_PROBE_USER_HOUR=15
QUOTA_PROBE_USER_DAY=40
QUOTA_PROBE_GLOBAL_HOUR=200

# auth — попытки подключения с паролем
QUOTA_AUTH_USER_HOUR=10
QUOTA_AUTH_USER_DAY=25
QUOTA_AUTH_GLOBAL_HOUR=120

# Неудачные входы: главный признак перебора.
# fail_user_host — промахов по ОДНОМУ серверу, потом сервер закрыт на час
# fail_user_total — промахов всего, потом закрыты все подключения на час
QUOTA_FAIL_USER_HOST=3
QUOTA_FAIL_USER_TOTAL=8

# Сколько РАЗНЫХ серверов пользователь трогает за сутки.
QUOTA_DISTINCT_HOSTS_DAY=8

# Одновременных SSH-сессий на весь бот
QUOTA_MAX_CONCURRENT_SSH=5

# ============ Redis ============
# Хранит счётчики квот и состояния диалогов. Без него всё в памяти
# процесса, и рестарт контейнера обнуляет лимиты.
# В docker-compose адрес уже прописан, здесь оставьте пустым.
REDIS_URL=

# ============ Лимиты ============
RATE_LIMIT_SECONDS=0.7
HEAVY_OP_COOLDOWN_SECONDS=10
MAX_FILE_SIZE_MB=20
SSH_CONNECT_TIMEOUT=15
TWOFA_TIMEOUT=120
SSH_DEFAULT_PORT=22

# ============ Криптография ============
RSA_SSH_KEY_SIZE=4096
RSA_X509_KEY_SIZE=3072

# ============ Логи и health ============
LOG_LEVEL=INFO
# В Docker логи собирает сам движок, файл обычно не нужен
LOG_TO_FILE=0
LOG_DIR=/app/logs
HEALTHCHECK_FILE=/tmp/bot-healthy
HEARTBEAT_INTERVAL=30
